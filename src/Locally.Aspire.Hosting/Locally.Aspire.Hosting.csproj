<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Locally.Aspire.Hosting</PackageId>
    <Description>Runs an Aspire AppHost's Azure resources in Locally: under `locally run`, `aspire run` provisions them in Locally instead of Azure.</Description>
    <PackageTags>aspire;azure;locally;hosting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Locally.Aspire.Hosting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.AppService" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Redis" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
  </ItemGroup>

</Project>
