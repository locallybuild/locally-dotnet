<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Locally.Aspire.Client</PackageId>
    <Description>Signs an Aspire app's Azure clients in to Locally: under `locally run`, every Azure client uses Locally's identity, with no request to login.microsoftonline.com.</Description>
    <PackageTags>aspire;azure;locally;identity</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Locally.Aspire.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.1" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.1" />
  </ItemGroup>

</Project>
